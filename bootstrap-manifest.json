{
  "schema_version": 1,
  "python_dependencies": [
    "PyYAML>=6.0,<7"
  ],
  "runtime_paths": [
    "agentit",
    "bootstrap.py",
    "bootstrap-manifest.json",
    "profiles.yaml",
    "registry.yaml",
    "settings.json",
    "AGENTS.md",
    "CLAUDE.md",
    "CODEX.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "router",
    "skills",
    "agents",
    ".codex/agents",
    "mcp",
    "probes",
    "capabilities",
    "references",
    "docs",
    "hooks",
    "templates"
  ],
  "runtime_exclude_names": [
    "__pycache__",
    ".DS_Store"
  ],
  "runtime_exclude_prefixes": [
    "router/test_"
  ],
  "core_skills": [
    "using-agentit",
    "task-router",
    "using-agent-skills"
  ],
  "codex_agent_profiles": [
    "luna-worker.toml",
    "terra-worker.toml"
  ],
  "providers": {
    "claude": {
      "skills_root": ".claude/skills",
      "legacy_skill_roots": [
        ".claude/skills"
      ]
    },
    "codex": {
      "skills_root": ".agents/skills",
      "legacy_skill_roots": [
        ".codex/skills",
        ".agents/skills"
      ],
      "codex_agents_source": ".codex/agents",
      "agents_root": ".codex/agents"
    },
    "grok": {
      "skills_root": ".grok/skills",
      "legacy_skill_roots": [
        ".grok/skills"
      ]
    },
    "gemini": {
      "skills_root": ".gemini/skills",
      "legacy_skill_roots": [
        ".gemini/skills",
        ".agents/skills"
      ]
    },
    "antigravity": {
      "skills_root": ".gemini/config/skills",
      "legacy_skill_roots": [
        ".gemini/config/skills",
        ".agents/skills"
      ]
    }
  },
  "optional_templates": {
    "claude_local_settings": {
      "source": "templates/claude/settings.local.example.json",
      "destination": ".claude/settings.local.json"
    },
    "claude_settings": {
      "source": "settings.json",
      "destination": ".claude/settings.json"
    },
    "claude_hook": {
      "source": "hooks/precompact-memory.sh",
      "destination": ".claude/hooks/precompact-memory.sh",
      "mode": "0755"
    }
  }
}
